#   cp .env.example .env
#
# Values for deploy/docker-compose.yml. Variables marked REQUIRED have no default: compose refuses
# to start without them rather than running with a shipped secret.

# Backend profile
# jetson: real hardware (strict actuator safety, data only from the edge agent over MQTT).
# dev: telemetry simulator + /api/dev tools, for working without hardware. Switch back to jetson
# before the edge agent starts publishing, otherwise simulated and real data end up mixed.
SPRING_PROFILES_ACTIVE=jetson
# Only read under the dev profile. Keep it off unless you are deliberately demoing without hardware:
# at 10 s the simulator writes roughly 390k sensor_reading rows per day.
DEV_SIMULATOR_ENABLED=false
DEV_SIMULATOR_INTERVAL=30s

# Telemetry retention (what keeps the database from growing without bound).
# sensor_reading rows older than READINGS_MAX_AGE and raw telemetry_message rows older than
# RAW_MESSAGES_MAX_AGE are deleted in small batches every RETENTION_INTERVAL. Durations: 30d, 12h, 30m.
# Long-range charts use the hourly rollup, which is never deleted; 30 days of raw readings is ~3 GB.
TELEMETRY_RETENTION_ENABLED=true
TELEMETRY_READINGS_MAX_AGE=30d
TELEMETRY_RAW_MESSAGES_MAX_AGE=7d
TELEMETRY_RETENTION_INTERVAL=1h

# Notifikasi push ke HP untuk peringatan (Web Push). Browser hanya mengizinkannya lewat HTTPS
# (atau http://localhost), jadi aktifkan setelah dashboard punya domain/HTTPS.
# Buat kunci SEKALI lalu simpan; mengganti kunci memutus semua langganan:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT: kontak pengirim untuk server push (Apple wajib), mailto:... atau https://...
# PUSH_MIN_SEVERITY: INFO | WARNING | CRITICAL (peringatan setingkat ini ke atas yang dikirim).
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_MIN_SEVERITY=CRITICAL

# Layanan AI tim AI (repo Fertigation_Service) di Jetson: gunicorn start.sh di port 5555 (flask dev: 5000),
# mis. AI_SERVICE_URL=http://host.docker.internal:5555. Layanan AI butuh Postgres sendiri (POSTGRESQL_URL di .env AI).
# Durasi jadwal siram diambil dari fuzzy irigasinya; durasi isian petani dipakai sebagai cadangan bila AI tidak
# menjawab / data sensor belum siap. Pemupukan otomatis (jarak hari + dosis N/P/K) juga dari AI.
# Kosong = AI tidak dipanggil. Server AI harus bisa dicapai dari kontainer (bukan hanya 127.0.0.1).
# IRRIGATION_DURATION_SOURCE: AI | MANUAL (MANUAL = selalu durasi isian petani).
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=90s
IRRIGATION_DURATION_SOURCE=AI
# Pemupukan otomatis sebelum sesi siram pertama hari jatuh tempo. false = tidak pernah memupuk otomatis.
FERTILIZATION_ENABLED=true
# Lama aduk setelah pompa K (detik). Pompa aduk total dibatasi 600 s.
FERTILIZATION_MIX_SECONDS=120

# Database
POSTGRES_DB=fertimata
# Published on 127.0.0.1 only; reach it from pgAdmin through an SSH tunnel to the Jetson.
POSTGRES_HOST_PORT=15432
DATABASE_USERNAME=fertimata
# REQUIRED
DATABASE_PASSWORD=

# Security
# REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=fertimata-backend
# Session length without signing in again (silent renewal through refresh tokens).
JWT_REFRESH_TOKEN_TTL_DAYS=7

# REQUIRED. Every origin the browser may open the dashboard from, comma-separated, no trailing
# slash: the Cloudflare Tunnel hostname and the Jetson LAN address. A WebSocket handshake from an
# origin missing here is refused with 403.
PUBLIC_ORIGINS=https://melon.example.com,http://192.168.1.50

# First-run operator account. Created only while the user table is empty.
BOOTSTRAP_OPERATOR_USERNAME=operator
# REQUIRED
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_FULL_NAME=Field Operator

# MQTT (broker is published on 127.0.0.1 only; set credentials here if mosquitto.conf requires them)
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic templates default to fertimata/{deviceId}/... . An edge agent that still publishes on the old
# smartmelon/ prefix keeps working if you uncomment these (or update the agent).
#MQTT_TOPIC_TELEMETRY=smartmelon/{deviceId}/telemetry
#MQTT_TOPIC_STATUS=smartmelon/{deviceId}/status
#MQTT_TOPIC_COMMAND=smartmelon/{deviceId}/command
#MQTT_TOPIC_COMMAND_ACK=smartmelon/{deviceId}/command/ack
#MQTT_TOPIC_AI=smartmelon/{deviceId}/ai
#MQTT_TOPIC_ALERT=smartmelon/{deviceId}/alert

# Trolley photos: the edge agent's camera.root on the host, mounted read-only into the backend and
# served at /captures/**. Change only if the edge agent's WorkingDirectory or camera.root changes.
CAPTURES_HOST_DIR=/var/lib/fertimata/data/citra

# Frontend
# Path to the frontend repository, relative to this directory.
FRONTEND_CONTEXT=../../FE_FeriMata
SITE_NAME=FertiMata
SITE_LOCATION=

# Host port Caddy listens on. cloudflared must point at http://localhost:<HTTP_PORT>.
HTTP_PORT=80

# Memory limits (the Jetson's 8 GB are shared with inference)
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=512m

# Logging: DEBUG, INFO, WARN or ERROR. No inline comment after the value.
LOG_LEVEL_APP=INFO
