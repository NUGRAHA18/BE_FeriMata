#   cp .env.example .env

# Semua nilai di bawah ini udah ada default-nya di application.yml
# kecuali JWT_SECRET. Ini sengaja dikosongin biar aplikasinya nggak mau
# jalan kalau belum diisi, daripada pakai secret bawaan.

# Runtime
# Profile "dev" bakal nyalain mock messaging, simulator telemetri, sama dokumentasi API publik.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL; Supabase-compatible)
DATABASE_URL=jdbc:postgresql://localhost:5432/fertimata
DATABASE_USERNAME=fertimata
DATABASE_PASSWORD=your_secure_password_here
DATABASE_POOL_SIZE=10

# PostgreSQL Docker
POSTGRES_PORT=5432
POSTGRES_DB=fertimata

# Supabase example - pakai host connection pooler-nya dan wajib SSL:
# DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project-ref>
# DATABASE_PASSWORD=<supabase-database-password>

# Security
JWT_SECRET=
JWT_ISSUER=fertimata-backend
JWT_ACCESS_TOKEN_TTL_MINUTES=60
# Lama sesi login tanpa masuk ulang (perpanjangan otomatis lewat refresh token).
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Origin Next.js 
FRONTEND_URL=http://localhost:3000

# First-run operator account. Cuma dibuat kalau tabel usernya masih kosong.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=change-me
BOOTSTRAP_OPERATOR_FULL_NAME=Field Operator

# Realtime
WEBSOCKET_ENDPOINT=/ws
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
WEBSOCKET_REQUIRE_AUTHENTICATION=true

# MQTT
# Kalau false, bakalan pakai in-memory loopback transport:
# backend-nya jalan tanpa broker sama sekali.
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=fertimata-backend

#broker mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# Template topik SEMENTARA. {deviceId} bakal diganti sama kode perangkatnya.
# Ini belum final sama tim hardware, jadi cukup ubah di sini aja.
MQTT_TOPIC_TELEMETRY=fertimata/{deviceId}/telemetry
MQTT_TOPIC_STATUS=fertimata/{deviceId}/status
MQTT_TOPIC_COMMAND=fertimata/{deviceId}/command
MQTT_TOPIC_COMMAND_ACK=fertimata/{deviceId}/command/ack
MQTT_TOPIC_AI=fertimata/{deviceId}/ai
MQTT_TOPIC_ALERT=fertimata/{deviceId}/alert

# Katalog hardware (device, sensor, actuator, sama interlock dari satu revisi hardware).
HARDWARE_CATALOG_SYNC=true

# Tolak perintah yang mau diaktifin kalau device-nya lagi nggak ONLINE
# (di profile jetson default-nya true).
ACTUATOR_REFUSE_WHEN_DEVICE_OFFLINE=false
# Batas waktu (TTL) buat perintah di kabel, misalnya 30s.
# Kalau dikosongin berarti nggak ada field expiresAt.
ACTUATOR_COMMAND_TTL=

# Deteksi device online/offline
# (masih sementara - tergantung interval heartbeat di firmware)
DEVICE_OFFLINE_TIMEOUT_SECONDS=120
DEVICE_LIVENESS_CHECK_INTERVAL_SECONDS=30
DEVICE_AUTO_REGISTER=true

# Aturan buat nerima data telemetri
TELEMETRY_AUTO_REGISTER_SENSORS=true
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
TELEMETRY_MAX_METRICS_PER_MESSAGE=64

# Retensi telemetri - INI yang nahan database biar nggak membengkak.
# Pembacaan sensor (sensor_reading) disimpan selama READINGS_MAX_AGE, payload mentah (telemetry_message)
# cuma selama RAW_MESSAGES_MAX_AGE. Format durasi: 30d, 12h, 90m. Default profile dev: 7d / 1d,
# profile jetson: 30d / 7d. Set TELEMETRY_RETENTION_ENABLED=false cuma kalau mau simpan semuanya.
TELEMETRY_RETENTION_ENABLED=true
TELEMETRY_READINGS_MAX_AGE=7d
TELEMETRY_RAW_MESSAGES_MAX_AGE=1d
TELEMETRY_RETENTION_INTERVAL=1h
# Ringkasan per jam (sensor_reading_hourly) untuk grafik jangka panjang; tidak dihapus retensi.
# LOOKBACK harus lebih lama dari INTERVAL supaya kiriman terlambat dari buffer edge tidak terlewat.
TELEMETRY_ROLLUP_INTERVAL=15m
TELEMETRY_ROLLUP_LOOKBACK=2h

# Notifikasi push ke HP untuk peringatan (Web Push). Browser hanya mengizinkannya lewat HTTPS
# (atau http://localhost), jadi aktifkan setelah dashboard punya domain/HTTPS.
# Buat kunci SEKALI lalu simpan; mengganti kunci memutus semua langganan:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT: kontak pengirim untuk server push (Apple wajib), mailto:... atau https://...
# PUSH_MIN_SEVERITY: INFO | WARNING | CRITICAL (peringatan setingkat ini ke atas yang dikirim).
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_MIN_SEVERITY=CRITICAL

# Folder foto trolley edge agent (camera.root), disajikan di /captures/**. Kosong = tidak disajikan.
# Buat uji lokal dengan mvnw, arahkan ke folder data/citra repo edge, mis. ../EDGE-melonSmart/data/citra
CAPTURES_DIR=

# Tool buat development (cuma aktif di profile dev)
# Device sama range metric buat simulator ada di application-dev.yml dan ngikutin katalog.
# Interval 10s = ±390 ribu baris sensor_reading per hari. 30s sudah cukup buat dashboard terasa hidup.
DEV_SIMULATOR_ENABLED=true
DEV_SIMULATOR_INTERVAL=30s

# Logging
# Pilihannya: DEBUG, INFO, WARN, atau ERROR.
# Jangan kasih komentar di baris yang sama setelah nilainya.
# Karena file .env itu properties file, komentarnya bakalan ikut kebaca sebagai nilai,
# dan itu bikin semua profile selain dev gagal jalan.
LOG_LEVEL_APP=INFO
LOG_LEVEL_MQTT=INFO
