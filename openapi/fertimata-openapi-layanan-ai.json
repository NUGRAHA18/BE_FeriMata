{
  "openapi": "3.1.0",
  "info": {
    "title": "FertiMata Backend API: layanan AI",
    "description": "Endpoint yang dibutuhkan layanan AI (penjadwal dosing/campur pupuk di Jetson).\nAlamat di Jetson: `http://127.0.0.1` (lewat Caddy, bukan port 8080). Login dengan\nakun OPERATOR khusus layanan (mis. `layanan-ai`, dibuat admin).\n\n1. `POST /api/auth/login` → `accessToken` (60 menit); perpanjang dengan `POST /api/auth/refresh`.\n2. `GET /api/ai/inputs` → nilai sensor dengan nama field persis seperti form fuzzy\n   (`fertilization`, `irrigation`) + `hst`. Jangan dosing bila `readyForFertilization`\n   false (data kosong/basi > 15 menit, atau tanggal tanam belum diisi); alasannya di `problems`.\n3. `GET /api/actuators` → `id` pompa (`DOSING-N/P/K`, `STIRRER`) dan `maxRunSeconds`.\n4. `POST /api/actuators/{id}/commands` `{\"command\":\"ON\",\"parameters\":{\"durationSeconds\":N}}`\n   → `commandUid`. Ditolak aturan keselamatan → 409 dengan `details.interlock`.\n5. `GET /api/actuators/commands/{commandUid}` sampai `EXECUTED` atau `FAILED`\n   (`failureCode`, mis. NO_RESPONSE, INTERLOCK_POWER); lalu langkah berikutnya.\n\nPenyiraman terjadwal dikerjakan backend, bukan layanan AI.\n",
    "contact": {
      "name": "FertiMata team"
    },
    "license": {
      "name": "Internal project"
    },
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1",
      "description": "Di Jetson (layanan AI, lewat Caddy)"
    },
    {
      "url": "http://localhost:8080",
      "description": "Laptop (docker compose dev)"
    }
  ],
  "tags": [
    {
      "name": "AI detections",
      "description": "Results produced by the vision model on the edge device"
    },
    {
      "name": "Actuators",
      "description": "Controllable outputs and their command history"
    },
    {
      "name": "Authentication",
      "description": "Sign-in, session refresh, password change"
    },
    {
      "name": "Cultivation",
      "description": "Transplant date, days after transplant (HST) and growth phase"
    }
  ],
  "paths": {
    "/actuator/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Backend health",
        "description": "Public. {\"status\":\"UP\"} when the backend and its database are reachable.",
        "responses": {
          "200": {
            "description": "Up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Down"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Exchange a refresh token for a new token pair",
        "description": "The refresh token is single-use: the previous one is revoked. 401 when it is unknown, expired, revoked or the account is disabled.",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "User-Agent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New token pair",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token no longer valid; sign in again",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in",
        "description": "Returns a short-lived JWT access token (Authorization: Bearer) and a refresh token that keeps the session alive for days.",
        "operationId": "login",
        "parameters": [
          {
            "name": "User-Agent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/actuators": {
      "get": {
        "tags": [
          "Actuators"
        ],
        "summary": "List actuators",
        "description": "Disabled actuators (not installed or retired) are left out unless includeDisabled=true, which the settings screen uses to re-enable one.",
        "operationId": "list",
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeDisabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Actuator"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/actuators/{id}/commands": {
      "get": {
        "tags": [
          "Actuators"
        ],
        "summary": "List the command history of an actuator",
        "operationId": "commandHistory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Actuators"
        ],
        "summary": "Command an actuator",
        "description": "Persists an audit record, then publishes the command to the device. A 202 means the\ncommand reached the messaging layer, not that the hardware acted on it - watch the\ncommand status, which only becomes EXECUTED when the device acknowledges it.\n",
        "operationId": "issueCommand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActuatorCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Command accepted and published",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ActuatorCommand"
                }
              }
            }
          },
          "400": {
            "description": "Actuator disabled or command invalid",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Messaging infrastructure unavailable; the attempt is still recorded as FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cultivation/active": {
      "get": {
        "tags": [
          "Cultivation"
        ],
        "summary": "Today's HST and growth phase",
        "description": "HST counted from the transplant date, the phase in effect with its EC target (phases follow the AI team's fuzzy), and the next phase. 404 when the transplant date is not set.",
        "operationId": "active",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CycleStatus"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/ai/inputs": {
      "get": {
        "tags": [
          "AI detections"
        ],
        "summary": "Sensor snapshot for the AI service's fuzzy forms",
        "description": "Field names match the AI service forms (run_fertilization, run_irrigation). Calibrated values when available. A field whose reading is missing or older than app.ai.inputs.max-age is null and listed in problems; do not dose unless readyForFertilization is true (safety rule S9).",
        "operationId": "inputs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AiInputs"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/actuators/{id}/status": {
      "get": {
        "tags": [
          "Actuators"
        ],
        "summary": "Get the last state the device reported for an actuator",
        "description": "Null until the device reports one; the backend does not infer state from commands.",
        "operationId": "status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ActuatorStatus"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/actuators/commands/{commandUid}": {
      "get": {
        "tags": [
          "Actuators"
        ],
        "summary": "Get one command by its commandUid",
        "description": "The commandUid is returned by POST /api/actuators/{id}/commands. Poll it until status is EXECUTED or FAILED (failureCode tells why, e.g. NO_RESPONSE, INTERLOCK_POWER).",
        "operationId": "command",
        "parameters": [
          {
            "name": "commandUid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ActuatorCommand"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Standard error response",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T04:41:07Z"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Invalid request"
          },
          "path": {
            "type": "string",
            "example": "/api/actuators/1/commands"
          },
          "details": {
            "type": "object",
            "additionalProperties": {},
            "description": "Field-level details, present for validation errors"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed JWT access token"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the access token expires",
            "example": 3600
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token; send it to /api/auth/refresh before expiresAt passes"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the refresh token, and with it the session, ends"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "Account",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string",
            "example": "operator"
          },
          "fullName": {
            "type": "string",
            "example": "Field Operator"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR",
              "VIEWER"
            ],
            "example": "OPERATOR"
          },
          "enabled": {
            "type": "boolean"
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "True after an admin reset or on a new account: the client should ask for a new password"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "operator",
            "maxLength": 64,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "example": "change-me",
            "maxLength": 128,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "ActuatorRegistrationRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string",
            "example": "DOSING-N",
            "maxLength": 64,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "example": "Pompa dosing N",
            "maxLength": 128,
            "minLength": 0
          },
          "type": {
            "type": "string",
            "example": "DOSING_PUMP",
            "maxLength": 64,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "maxRunSeconds": {
            "type": "integer",
            "format": "int32",
            "description": "Longest run one activating command may request; omit for no limit",
            "exclusiveMinimum": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "Informational hardware binding, e.g. Modbus address and channel"
          }
        },
        "required": [
          "code",
          "deviceId",
          "name"
        ]
      },
      "Actuator": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "deviceId": {
            "type": "integer",
            "format": "int64"
          },
          "deviceCode": {
            "type": "string",
            "example": "RIO-TANK-01"
          },
          "code": {
            "type": "string",
            "example": "DOSING-N"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Free text; the hardware catalogue decides the values",
            "example": "DOSING_PUMP"
          },
          "enabled": {
            "type": "boolean"
          },
          "currentState": {
            "type": "string",
            "description": "Last state reported by the device",
            "example": "OFF"
          },
          "stateUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "maxRunSeconds": {
            "type": "integer",
            "format": "int32",
            "description": "Longest run one activating command may request; null means no limit"
          },
          "supportedCommands": {
            "type": "array",
            "description": "Command names this actuator accepts; null when its type is unrestricted",
            "example": [
              "ON",
              "OFF"
            ],
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": "string",
            "description": "Informational hardware binding; never used for decisions"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActuatorCommandRequest": {
        "type": "object",
        "example": {
          "command": "ON",
          "parameters": {
            "durationSeconds": 60
          }
        },
        "properties": {
          "command": {
            "type": "string",
            "description": "Command name understood by the device",
            "example": "ON",
            "maxLength": 64,
            "minLength": 0
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {},
            "description": "Free-form arguments passed through to the device"
          }
        },
        "required": [
          "command"
        ]
      },
      "ActuatorCommand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "commandUid": {
            "type": "string",
            "description": "Correlation id echoed by the device in its acknowledgement"
          },
          "actuatorId": {
            "type": "integer",
            "format": "int64"
          },
          "actuatorCode": {
            "type": "string"
          },
          "deviceId": {
            "type": "integer",
            "format": "int64"
          },
          "deviceCode": {
            "type": "string"
          },
          "commandType": {
            "type": "string",
            "example": "ON"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {}
          },
          "source": {
            "type": "string",
            "enum": [
              "OPERATOR",
              "AUTOMATION",
              "SYSTEM"
            ]
          },
          "requestedBy": {
            "type": "string",
            "description": "Username that requested it; null for automation and system commands"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SENT",
              "EXECUTED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorMessage": {
            "type": "string"
          },
          "failureCode": {
            "type": "string",
            "description": "Reason code from a failed device acknowledgement, e.g. INTERLOCK_POWER; null when the failure carried no code",
            "example": "INTERLOCK_FLOAT"
          }
        }
      },
      "CycleStatus": {
        "type": "object",
        "properties": {
          "cycle": {
            "$ref": "#/components/schemas/PlantingCycle"
          },
          "today": {
            "type": "string",
            "format": "date"
          },
          "hst": {
            "type": "integer",
            "format": "int64"
          },
          "currentPhase": {
            "$ref": "#/components/schemas/GrowthPhase"
          },
          "nextPhase": {
            "$ref": "#/components/schemas/GrowthPhase"
          },
          "daysUntilNextPhase": {
            "type": "integer",
            "format": "int64"
          },
          "plantCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GrowthPhase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startHst": {
            "type": "integer",
            "format": "int32"
          },
          "endHst": {
            "type": "integer",
            "format": "int32"
          },
          "ecTargetMin": {
            "type": "number"
          },
          "ecTargetMax": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "PlantingCycle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "variety": {
            "type": "string"
          },
          "transplantDate": {
            "type": "string",
            "format": "date"
          },
          "expectedHarvestDate": {
            "type": "string",
            "format": "date"
          },
          "endedAt": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "ACTIVE",
              "ENDED"
            ]
          },
          "notes": {
            "type": "string"
          },
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrowthPhase"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AiInputReading": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "description": "Calibrated value when the sensor has a calibration, else raw"
          },
          "rawValue": {
            "type": "number"
          },
          "calibrated": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ageSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "fresh": {
            "type": "boolean"
          }
        }
      },
      "AiInputs": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "maxAgeSeconds": {
            "type": "integer",
            "format": "int64",
            "description": "Readings older than this are stale",
            "example": 900
          },
          "hst": {
            "type": "integer",
            "format": "int32",
            "description": "Days since the transplant date; null when it is not set in Settings"
          },
          "phaseCode": {
            "type": "string",
            "example": "PEMBUAHAN"
          },
          "phaseName": {
            "type": "string",
            "example": "Pembuahan"
          },
          "readyForFertilization": {
            "type": "boolean",
            "description": "All fertilization fields present, fresh, and HST known"
          },
          "readyForIrrigation": {
            "type": "boolean",
            "description": "All irrigation fields present, fresh, and HST known"
          },
          "fertilization": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Form fields for run_fertilization: ec, ph, nitrogen_tanah, phosfor_tanah, kalium_tanah, hst"
          },
          "irrigation": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Form fields for run_irrigation: ec_air, suhu_air, suhu_udara, rh, humidity_tanah, temp_tanah, ph, nitrogen, phosfor, kalium, ec_tanah, hst"
          },
          "readings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AiInputReading"
            },
            "description": "Per metric key: the reading behind each field"
          },
          "problems": {
            "type": "array",
            "description": "Why a form is not ready, e.g. \"fertilization.ph (tank.ph): stale, 1820 s old\"",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ActuatorStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "currentState": {
            "type": "string"
          },
          "stateUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deviceCode": {
            "type": "string"
          }
        }
      },
      "PageResponse": {
        "type": "object",
        "description": "A page of results",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActuatorCommand"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "last": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Obtain a token from POST /api/auth/login",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}